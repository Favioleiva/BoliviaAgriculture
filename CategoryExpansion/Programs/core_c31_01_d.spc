RUNDEF core_c31_01_d
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE DEPTO.V1 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" TYPE INTEGER
DEFINE UPA.R1 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" TYPE INTEGER
DEFINE DEPTO.V2 AS COUNT UPA FILTER UPA.R1 > 0 TYPE INTEGER
DEFINE DEPTO.V3 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" AND CULTFOR.S4_P27_B >= 0.000000 AND CULTFOR.S4_P27_B <= 99999999999.000000 TYPE INTEGER
DEFINE DEPTO.V4 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" AND MISSING(CULTFOR.S4_P27_B) TYPE INTEGER
DEFINE DEPTO.V5 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" AND NOTAPPLICABLE(CULTFOR.S4_P27_B) TYPE INTEGER
DEFINE DEPTO.V6 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" AND CULTFOR.S4_P27_B = 0 TYPE INTEGER
DEFINE DEPTO.V7 AS SUM CULTFOR.S4_P27_B FILTER CULTFOR.S4_P27_A = "03088888" AND CULTFOR.S4_P27_B >= 0.000000 AND CULTFOR.S4_P27_B <= 99999999999.000000 TYPE REAL DECIMALS 6
DEFINE UPA.P1A0 AS COUNT CULTFOR FILTER CULTFOR.S4_P27_A = "03088888" AND CULTFOR.S4_P27_B >= 0.000000 AND CULTFOR.S4_P27_B <= 99999999999.000000 AND CULTFOR.S4_P27_B > 0 TYPE INTEGER
DEFINE DEPTO.V8 AS COUNT UPA FILTER UPA.P1A0 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF DEPTO, DEPTO.V1, DEPTO.V2, DEPTO.V3, DEPTO.V4, DEPTO.V5, DEPTO.V6, DEPTO.V7, DEPTO.V8
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\CategoryExpansion\Results\core_c31_01_d.csv" UTF8
