RUNDEF core_c01_01_m
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE MUNIC.V1 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" TYPE INTEGER
DEFINE UPA.R1 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" TYPE INTEGER
DEFINE MUNIC.V2 AS COUNT UPA FILTER UPA.R1 > 0 TYPE INTEGER
DEFINE MUNIC.V3 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" AND CULTSEM.S4_P25_B >= 0.000000 AND CULTSEM.S4_P25_B <= 99999999999.000000 TYPE INTEGER
DEFINE MUNIC.V4 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" AND MISSING(CULTSEM.S4_P25_B) TYPE INTEGER
DEFINE MUNIC.V5 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" AND NOTAPPLICABLE(CULTSEM.S4_P25_B) TYPE INTEGER
DEFINE MUNIC.V6 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" AND CULTSEM.S4_P25_B = 0 TYPE INTEGER
DEFINE MUNIC.V7 AS SUM CULTSEM.S4_P25_B FILTER CULTSEM.S4_P25_A = "01802001" AND CULTSEM.S4_P25_B >= 0.000000 AND CULTSEM.S4_P25_B <= 99999999999.000000 TYPE REAL DECIMALS 6
DEFINE UPA.P1A0 AS COUNT CULTSEM FILTER CULTSEM.S4_P25_A = "01802001" AND CULTSEM.S4_P25_B >= 0.000000 AND CULTSEM.S4_P25_B <= 99999999999.000000 AND CULTSEM.S4_P25_B > 0 TYPE INTEGER
DEFINE MUNIC.V8 AS COUNT UPA FILTER UPA.P1A0 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V1, MUNIC.V2, MUNIC.V3, MUNIC.V4, MUNIC.V5, MUNIC.V6, MUNIC.V7, MUNIC.V8
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\CategoryExpansion\Results\core_c01_01_m.csv" UTF8
