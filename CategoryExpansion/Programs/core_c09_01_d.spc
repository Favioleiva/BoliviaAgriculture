RUNDEF core_c09_01_d
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE DEPTO.V1 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" TYPE INTEGER
DEFINE UPA.R1 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" TYPE INTEGER
DEFINE DEPTO.V2 AS COUNT UPA FILTER UPA.R1 > 0 TYPE INTEGER
DEFINE DEPTO.V3 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" AND CULTINV.S4_P23_3 >= 0.000000 AND CULTINV.S4_P23_3 <= 999999.000000 TYPE INTEGER
DEFINE DEPTO.V4 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" AND MISSING(CULTINV.S4_P23_3) TYPE INTEGER
DEFINE DEPTO.V5 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" AND NOTAPPLICABLE(CULTINV.S4_P23_3) TYPE INTEGER
DEFINE DEPTO.V6 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" AND CULTINV.S4_P23_3 = 0 TYPE INTEGER
DEFINE DEPTO.V7 AS SUM CULTINV.S4_P23_3 FILTER CULTINV.S4_P23_2 = "01318000" AND CULTINV.S4_P23_3 >= 0.000000 AND CULTINV.S4_P23_3 <= 999999.000000 TYPE REAL DECIMALS 6
DEFINE UPA.P1A0 AS COUNT CULTINV FILTER CULTINV.S4_P23_2 = "01318000" AND CULTINV.S4_P23_3 >= 0.000000 AND CULTINV.S4_P23_3 <= 999999.000000 AND CULTINV.S4_P23_3 > 0 TYPE INTEGER
DEFINE DEPTO.V8 AS COUNT UPA FILTER UPA.P1A0 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF DEPTO, DEPTO.V1, DEPTO.V2, DEPTO.V3, DEPTO.V4, DEPTO.V5, DEPTO.V6, DEPTO.V7, DEPTO.V8
