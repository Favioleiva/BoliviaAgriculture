RUNDEF pair_full_services_002_v4
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE MUNIC.V1 AS COUNT SEGURO FILTER SEGURO.COD114_2 = "0199999" TYPE INTEGER
DEFINE UPA.R2 AS COUNT SEGURO FILTER SEGURO.COD114_2 = "0199999" TYPE INTEGER
DEFINE MUNIC.V2 AS COUNT UPA FILTER UPA.R2 > 0 TYPE INTEGER
DEFINE MUNIC.V3 AS COUNT APOCRED TYPE INTEGER
DEFINE MUNIC.V4 AS COUNT ASIST TYPE INTEGER
DEFINE MUNIC.V5 AS COUNT SEGURO TYPE INTEGER
TABLE MRES AS AREALIST OF MUNIC, MUNIC.V1, MUNIC.V2, MUNIC.V3, MUNIC.V4, MUNIC.V5
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\FullExpansion\Results\full_services_002_v4_m.csv" UTF8
DEFINE DEPTO.V1 AS COUNT SEGURO FILTER SEGURO.COD114_2 = "0199999" TYPE INTEGER
DEFINE DEPTO.V2 AS COUNT UPA FILTER UPA.R2 > 0 TYPE INTEGER
DEFINE DEPTO.V3 AS COUNT APOCRED TYPE INTEGER
DEFINE DEPTO.V4 AS COUNT ASIST TYPE INTEGER
DEFINE DEPTO.V5 AS COUNT SEGURO TYPE INTEGER
TABLE DRES AS AREALIST OF DEPTO, DEPTO.V1, DEPTO.V2, DEPTO.V3, DEPTO.V4, DEPTO.V5
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\FullExpansion\Results\full_services_002_v4_d.csv" UTF8
