RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.R128 AS COUNT CAPRINO FILTER (CAPRINO.S6_P60A = 2 OR CAPRINO.S6_P60A = 3 OR CAPRINO.S6_P60A = 4) AND (((CAPRINO.S6_P60C >= 0 AND CAPRINO.S6_P60C <= 99999)) AND NOT MISSING(CAPRINO.S6_P60C) AND NOT NOTAPPLICABLE(CAPRINO.S6_P60C) AND CAPRINO.S6_P60C > 0) TYPE INTEGER
DEFINE MUNIC.V128 AS COUNT UPA FILTER UPA.R128 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V128
