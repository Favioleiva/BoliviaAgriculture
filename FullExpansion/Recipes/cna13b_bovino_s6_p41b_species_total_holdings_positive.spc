DEFINE UPA.R8 AS COUNT BOVINO FILTER (BOVINO.S6_P41A >= 3 AND BOVINO.S6_P41A <= 11) AND ((BOVINO.S6_P41B >= 0 AND BOVINO.S6_P41B <= 999999)) AND NOT MISSING(BOVINO.S6_P41B) AND NOT NOTAPPLICABLE(BOVINO.S6_P41B) AND BOVINO.S6_P41B > 0 TYPE INTEGER
