DEFINE UPA.R111 AS COUNT PORCINOC FILTER ((PORCINOC.S6_P57D >= 0 AND PORCINOC.S6_P57D <= 9999)) AND NOT MISSING(PORCINOC.S6_P57D) AND NOT NOTAPPLICABLE(PORCINOC.S6_P57D) TYPE INTEGER
