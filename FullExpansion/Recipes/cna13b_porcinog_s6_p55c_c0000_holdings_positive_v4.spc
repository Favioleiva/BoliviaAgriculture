DEFINE UPA.R160 AS COUNT PORCINOG FILTER (PORCINOG.S6_P55A = "01") AND ((PORCINOG.S6_P55C >= 0 AND PORCINOG.S6_P55C <= 99999)) AND NOT MISSING(PORCINOG.S6_P55C) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55C) AND PORCINOG.S6_P55C > 0 TYPE INTEGER
