DEFINE UPA.R24 AS COUNT BOVINO FILTER (BOVINO.S6_P41A >= 3 AND BOVINO.S6_P41A <= 11) AND ((BOVINO.S6_P41D >= 0 AND BOVINO.S6_P41D <= 999999)) AND NOT MISSING(BOVINO.S6_P41D) AND NOT NOTAPPLICABLE(BOVINO.S6_P41D) AND BOVINO.S6_P41D > 0 TYPE INTEGER
