RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.A26 AS COUNT COMPFAM FILTER COMPFAM.S15_P129_1 = 1 TYPE INTEGER
DEFINE UPA.C26 AS COUNT COMPFAM FILTER (COMPFAM.S15_P129_1 = 1) AND ((COMPFAM.S15_P129_5 >= 1 AND COMPFAM.S15_P129_5 <= 9)) TYPE INTEGER
DEFINE UPA.D26 AS UPA.A26 - UPA.C26 TYPE INTEGER
