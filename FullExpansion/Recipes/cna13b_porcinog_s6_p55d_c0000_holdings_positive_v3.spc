DEFINE UPA.R32 AS COUNT PORCINOG FILTER (TRIM(PORCINOG.S6_P55A) = "1") AND ((PORCINOG.S6_P55D >= 0 AND PORCINOG.S6_P55D <= 99999)) AND NOT MISSING(PORCINOG.S6_P55D) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55D) AND PORCINOG.S6_P55D > 0 TYPE INTEGER
