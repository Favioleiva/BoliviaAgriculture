RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.A6 AS COUNT CULTORG TYPE INTEGER
DEFINE UPA.C6 AS COUNT CULTORG FILTER ((CULTORG.S5_P37_1B = 1) OR (CULTORG.S5_P37_1B = 2) OR (CULTORG.S5_P37_1B = 9)) TYPE INTEGER
DEFINE UPA.D6 AS UPA.A6 - UPA.C6 TYPE INTEGER
