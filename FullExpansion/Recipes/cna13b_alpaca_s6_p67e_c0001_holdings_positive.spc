 NOWEIGHT

DEFINE UPA.R160 AS COUNT ALPACA FILTER (ALPACA.S6_P67A = 4) AND ((ALPACA.S6_P67E >= 0 AND ALPACA.S6_P67E <= 9999)) AND NOT MISSING(ALPACA.S6_P67E) AND NOT NOTAPPLICABLE(ALPACA.S6_P67E) AND ALPACA.S6_P67E > 0 TYPE INTEGER
