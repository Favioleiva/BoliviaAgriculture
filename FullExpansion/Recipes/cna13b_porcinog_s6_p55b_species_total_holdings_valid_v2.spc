DEFINE UPA.R55 AS COUNT PORCINOG FILTER (PORCINOG.S6_P55A = "02" OR PORCINOG.S6_P55A = "03" OR PORCINOG.S6_P55A = "04") AND (((PORCINOG.S6_P55B >= 0 AND PORCINOG.S6_P55B <= 99999)) AND NOT MISSING(PORCINOG.S6_P55B) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55B)) TYPE INTEGER
DEFINE MUNIC.V55 AS COUNT UPA FILTER UPA.R55 > 0 TYPE INTEGER
