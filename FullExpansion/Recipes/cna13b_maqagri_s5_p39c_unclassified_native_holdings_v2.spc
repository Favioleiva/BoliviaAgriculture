RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.A10 AS COUNT MAQAGRI TYPE INTEGER
DEFINE UPA.C10 AS COUNT MAQAGRI FILTER ((MAQAGRI.S5_P39C >= 1952 AND MAQAGRI.S5_P39C <= 2013) OR (MAQAGRI.S5_P39C = 9999)) TYPE INTEGER
DEFINE UPA.D10 AS UPA.A10 - UPA.C10 TYPE INTEGER
DEFINE MUNIC.V10 AS COUNT UPA FILTER UPA.D10 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V10
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\FullExpansion\RecipeRuns\cna13b_maqagri_s5_p39c_unclassified_native_holdings_v2.csv" UTF8
