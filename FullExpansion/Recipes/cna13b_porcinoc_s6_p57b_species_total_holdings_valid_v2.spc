DEFINE UPA.R95 AS COUNT PORCINOC FILTER (PORCINOC.S6_P57A = "02" OR PORCINOC.S6_P57A = "03" OR PORCINOC.S6_P57A = "04") AND (((PORCINOC.S6_P57B >= 0 AND PORCINOC.S6_P57B <= 9999)) AND NOT MISSING(PORCINOC.S6_P57B) AND NOT NOTAPPLICABLE(PORCINOC.S6_P57B)) TYPE INTEGER
