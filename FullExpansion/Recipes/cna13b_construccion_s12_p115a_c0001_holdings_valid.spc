RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.R65 AS COUNT CONSTRUCCION FILTER (CONSTRUCCION.S12_P115 = 2) AND ((CONSTRUCCION.S12_P115A >= 0.000000 AND CONSTRUCCION.S12_P115A <= 99998.000000)) AND NOT MISSING(CONSTRUCCION.S12_P115A) AND NOT NOTAPPLICABLE(CONSTRUCCION.S12_P115A) TYPE INTEGER
DEFINE MUNIC.V65 AS COUNT UPA FILTER UPA.R65 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V65
