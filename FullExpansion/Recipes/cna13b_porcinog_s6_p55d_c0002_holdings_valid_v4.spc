DEFINE UPA.R47 AS COUNT PORCINOG FILTER (PORCINOG.S6_P55A = "03") AND ((PORCINOG.S6_P55D >= 0 AND PORCINOG.S6_P55D <= 99999)) AND NOT MISSING(PORCINOG.S6_P55D) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55D) TYPE INTEGER
