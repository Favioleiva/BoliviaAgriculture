RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.A16 AS COUNT MAQUINARIA TYPE INTEGER
DEFINE UPA.C16 AS COUNT MAQUINARIA FILTER ((MAQUINARIA.S12_P116C >= 1952 AND MAQUINARIA.S12_P116C <= 1956) OR (MAQUINARIA.S12_P116C >= 1958 AND MAQUINARIA.S12_P116C <= 2013)) TYPE INTEGER
DEFINE UPA.D16 AS UPA.A16 - UPA.C16 TYPE INTEGER
DEFINE MUNIC.V16 AS COUNT UPA FILTER UPA.D16 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V16
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\FullExpansion\RecipeRuns\cna13b_maquinaria_s12_p116c_unclassified_native_holdings_v2.csv" UTF8
