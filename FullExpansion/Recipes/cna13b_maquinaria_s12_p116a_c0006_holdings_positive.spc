DEFINE UPA.R50 AS COUNT MAQUINARIA FILTER (MAQUINARIA.CATEGORIA = 7) AND ((MAQUINARIA.S12_P116A >= 0 AND MAQUINARIA.S12_P116A <= 9998)) AND NOT MISSING(MAQUINARIA.S12_P116A) AND NOT NOTAPPLICABLE(MAQUINARIA.S12_P116A) AND MAQUINARIA.S12_P116A > 0 TYPE INTEGER
