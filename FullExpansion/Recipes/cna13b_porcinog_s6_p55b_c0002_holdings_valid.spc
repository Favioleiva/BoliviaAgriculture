DEFINE UPA.R143 AS COUNT PORCINOG FILTER (PORCINOG.S6_P55A = "03") AND ((PORCINOG.S6_P55B >= 0 AND PORCINOG.S6_P55B <= 99999)) AND NOT MISSING(PORCINOG.S6_P55B) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55B) TYPE INTEGER
