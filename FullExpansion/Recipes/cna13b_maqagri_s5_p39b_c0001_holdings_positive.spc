DEFINE UPA.R50 AS COUNT MAQAGRI FILTER (MAQAGRI.S5_P39A = 2) AND ((MAQAGRI.S5_P39B >= 0 AND MAQAGRI.S5_P39B <= 999)) AND NOT MISSING(MAQAGRI.S5_P39B) AND NOT NOTAPPLICABLE(MAQAGRI.S5_P39B) AND MAQAGRI.S5_P39B > 0 TYPE INTEGER
