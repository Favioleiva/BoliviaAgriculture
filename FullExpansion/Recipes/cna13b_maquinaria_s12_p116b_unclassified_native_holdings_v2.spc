 NOWEIGHT

DEFINE UPA.A14 AS COUNT MAQUINARIA TYPE INTEGER
DEFINE UPA.C14 AS COUNT MAQUINARIA FILTER ((MAQUINARIA.S12_P116B >= 1952 AND MAQUINARIA.S12_P116B <= 1956) OR (MAQUINARIA.S12_P116B >= 1958 AND MAQUINARIA.S12_P116B <= 2013)) TYPE INTEGER
