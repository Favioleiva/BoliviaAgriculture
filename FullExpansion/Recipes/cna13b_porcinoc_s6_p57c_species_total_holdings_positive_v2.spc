DEFINE UPA.R104 AS COUNT PORCINOC FILTER (PORCINOC.S6_P57A = "02" OR PORCINOC.S6_P57A = "03" OR PORCINOC.S6_P57A = "04") AND (((PORCINOC.S6_P57C >= 0 AND PORCINOC.S6_P57C <= 9999)) AND NOT MISSING(PORCINOC.S6_P57C) AND NOT NOTAPPLICABLE(PORCINOC.S6_P57C) AND PORCINOC.S6_P57C > 0) TYPE INTEGER
DEFINE MUNIC.V104 AS COUNT UPA FILTER UPA.R104 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V104
