DEFINE UPA.R160 AS COUNT PORCINOC FILTER (PORCINOC.S6_P57A = "01") AND ((PORCINOC.S6_P57C >= 0 AND PORCINOC.S6_P57C <= 9999)) AND NOT MISSING(PORCINOC.S6_P57C) AND NOT NOTAPPLICABLE(PORCINOC.S6_P57C) AND PORCINOC.S6_P57C > 0 TYPE INTEGER
