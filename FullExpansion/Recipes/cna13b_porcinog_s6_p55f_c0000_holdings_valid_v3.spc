DEFINE UPA.R95 AS COUNT PORCINOG FILTER (TRIM(PORCINOG.S6_P55A) = "1") AND ((PORCINOG.S6_P55F >= 0 AND PORCINOG.S6_P55F <= 99999)) AND NOT MISSING(PORCINOG.S6_P55F) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55F) TYPE INTEGER
