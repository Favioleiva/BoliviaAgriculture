RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.R127 AS COUNT CAPRINO FILTER ((CAPRINO.S6_P60C >= 0 AND CAPRINO.S6_P60C <= 99999)) AND NOT MISSING(CAPRINO.S6_P60C) AND NOT NOTAPPLICABLE(CAPRINO.S6_P60C) TYPE INTEGER
