DEFINE UPA.R88 AS COUNT PORCINOG FILTER ((PORCINOG.S6_P55F >= 0 AND PORCINOG.S6_P55F <= 99999)) AND NOT MISSING(PORCINOG.S6_P55F) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55F) AND PORCINOG.S6_P55F > 0 TYPE INTEGER
DEFINE MUNIC.V88 AS COUNT UPA FILTER UPA.R88 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V88
