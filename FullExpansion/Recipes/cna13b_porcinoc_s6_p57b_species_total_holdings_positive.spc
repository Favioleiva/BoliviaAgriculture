DEFINE UPA.R96 AS COUNT PORCINOC FILTER ((PORCINOC.S6_P57B >= 0 AND PORCINOC.S6_P57B <= 9999)) AND NOT MISSING(PORCINOC.S6_P57B) AND NOT NOTAPPLICABLE(PORCINOC.S6_P57B) AND PORCINOC.S6_P57B > 0 TYPE INTEGER
