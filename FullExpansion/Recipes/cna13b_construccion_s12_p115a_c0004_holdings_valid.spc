DEFINE UPA.R89 AS COUNT CONSTRUCCION FILTER (CONSTRUCCION.S12_P115 = 5) AND ((CONSTRUCCION.S12_P115A >= 0.000000 AND CONSTRUCCION.S12_P115A <= 99998.000000)) AND NOT MISSING(CONSTRUCCION.S12_P115A) AND NOT NOTAPPLICABLE(CONSTRUCCION.S12_P115A) TYPE INTEGER
