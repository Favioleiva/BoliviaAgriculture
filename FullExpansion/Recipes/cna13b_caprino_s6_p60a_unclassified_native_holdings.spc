RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.A2 AS COUNT CAPRINO TYPE INTEGER
DEFINE UPA.C2 AS COUNT CAPRINO FILTER ((CAPRINO.S6_P60A = 2) OR (CAPRINO.S6_P60A = 3) OR (CAPRINO.S6_P60A = 4)) TYPE INTEGER
DEFINE UPA.D2 AS UPA.A2 - UPA.C2 TYPE INTEGER
DEFINE MUNIC.V2 AS COUNT UPA FILTER UPA.D2 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V2
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\FullExpansion\RecipeRuns\cna13b_caprino_s6_p60a_unclassified_native_holdings.csv" UTF8
