DEFINE UPA.R64 AS COUNT PORCINOG FILTER (TRIM(PORCINOG.S6_P55A) = "1") AND ((PORCINOG.S6_P55E >= 0 AND PORCINOG.S6_P55E <= 99999)) AND NOT MISSING(PORCINOG.S6_P55E) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55E) AND PORCINOG.S6_P55E > 0 TYPE INTEGER
DEFINE MUNIC.V64 AS COUNT UPA FILTER UPA.R64 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V64
