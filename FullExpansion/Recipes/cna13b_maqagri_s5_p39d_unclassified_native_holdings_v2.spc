RUNDEF individual
 DICTIONARY "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\RedatamExploration\WorkBase\CNA2013.dicx"
 SELECTION ALL
 NOWEIGHT

DEFINE UPA.A12 AS COUNT MAQAGRI TYPE INTEGER
DEFINE UPA.C12 AS COUNT MAQAGRI FILTER ((MAQAGRI.S5_P39D >= 1952 AND MAQAGRI.S5_P39D <= 2013) OR (MAQAGRI.S5_P39D = 9999)) TYPE INTEGER
DEFINE UPA.D12 AS UPA.A12 - UPA.C12 TYPE INTEGER
DEFINE MUNIC.V12 AS COUNT UPA FILTER UPA.D12 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V12
 OUTPUTFILE CSV "X:\Agentic Tasks\Bolivia\Outputs\Contract_04\Evidence\FullExpansion\RecipeRuns\cna13b_maqagri_s5_p39d_unclassified_native_holdings_v2.csv" UTF8
