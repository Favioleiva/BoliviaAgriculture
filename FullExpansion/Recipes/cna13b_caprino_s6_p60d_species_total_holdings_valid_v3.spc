DEFINE UPA.R135 AS COUNT CAPRINO FILTER (CAPRINO.S6_P60A = 2 OR CAPRINO.S6_P60A = 3 OR CAPRINO.S6_P60A = 4) AND (((CAPRINO.S6_P60D >= 0 AND CAPRINO.S6_P60D <= 99999)) AND NOT MISSING(CAPRINO.S6_P60D) AND NOT NOTAPPLICABLE(CAPRINO.S6_P60D)) TYPE INTEGER
