DEFINE UPA.R72 AS COUNT PORCINOG FILTER (PORCINOG.S6_P55A = "02" OR PORCINOG.S6_P55A = "03" OR PORCINOG.S6_P55A = "04") AND (((PORCINOG.S6_P55D >= 0 AND PORCINOG.S6_P55D <= 99999)) AND NOT MISSING(PORCINOG.S6_P55D) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55D) AND PORCINOG.S6_P55D > 0) TYPE INTEGER
DEFINE MUNIC.V72 AS COUNT UPA FILTER UPA.R72 > 0 TYPE INTEGER
TABLE RESULTA AS AREALIST OF MUNIC, MUNIC.V72
