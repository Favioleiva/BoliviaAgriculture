DEFINE UPA.R71 AS COUNT PORCINOG FILTER (PORCINOG.S6_P55A = "02") AND ((PORCINOG.S6_P55E >= 0 AND PORCINOG.S6_P55E <= 99999)) AND NOT MISSING(PORCINOG.S6_P55E) AND NOT NOTAPPLICABLE(PORCINOG.S6_P55E) TYPE INTEGER
